# App (Node 24+, single container). On Windows set DATA_DIR to workspace/data.
PORT=3000
DATA_DIR=/app/data
APP_TIMEZONE=Europe/Berlin
# Set the externally visible origin when using a reverse proxy.
APP_ORIGIN=

# Notion: share all three databases with the integration.
NOTION_TOKEN=
NOTION_TASKS_DATABASE_ID=
NOTION_PROJECTS_DATABASE_ID=
NOTION_AREAS_DATABASE_ID=
# Optional: required only when a database contains multiple data sources.
NOTION_TASKS_DATA_SOURCE_ID=
NOTION_PROJECTS_DATA_SOURCE_ID=
NOTION_AREAS_DATA_SOURCE_ID=
NOTION_TASK_TITLE_PROPERTY=Name
NOTION_TASK_DATE_PROPERTY=Due Date
NOTION_TASK_AREA_PROPERTY=Area
NOTION_TASK_PROJECT_PROPERTY=Project
NOTION_TASK_HIGHLIGHT_PROPERTY=Highlight
NOTION_PROJECT_TITLE_PROPERTY=
NOTION_PROJECT_AREA_PROPERTY=
NOTION_AREA_TITLE_PROPERTY=
# Optional project/area metadata names; otherwise known names are discovered.
NOTION_PROJECT_STATUS_PROPERTY=
NOTION_PROJECT_PRIORITY_PROPERTY=
NOTION_PROJECT_DATE_PROPERTY=
NOTION_AREA_TYPE_PROPERTY=
# Completion can also be selected safely in diagnostics.
NOTION_TASK_COMPLETION_PROPERTY=
NOTION_TASK_COMPLETION_VALUE=
NOTION_TASK_REOPEN_VALUE=

# Read-only fine-grained GitHub PAT
GITHUB_TOKEN=
GITHUB_USERNAME=

# Existing separate PostgREST service; never called directly by the browser.
CONTACT_API_BASE_URL=http://192.168.2.173:1917
# Optional single HTTP header, e.g. "Authorization: Bearer YOUR_TOKEN".
# Header name + colon + value; never a JSON object. Keep empty for anonymous access.
CONTACT_API_AUTH_HEADER=

# OPTIONAL GEMINI AI FALLBACK (server-only; deterministic parsing works without a key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_ENABLED=true
GEMINI_TIMEOUT_MS=5000
GEMINI_CONFIDENCE_THRESHOLD=0.75

# Optional closed-app Web Push (production, one Node server process).
# Requires HTTPS APP_ORIGIN above, Cloudflare Access on the whole app/API,
# a verified Notion completion mapping and outbound HTTPS to browser push services.
# Generate once: node node_modules/web-push/src/cli.js generate-vapid-keys --json
# Keep the private key server-only; preserve the pair across restarts.
# VAPID_SUBJECT: mailto:your-address@example.com or an HTTPS contact URL.
# Missing/invalid values disable push; in-app reminders continue to work.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
